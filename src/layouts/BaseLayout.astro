---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GRC Engineering Club AI Blog',
  description = 'Practical AI workflows for GRC work and perspectives on AI governance from the GRC Engineering Club.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="GRC Engineering Club AI Blog" href={`${base}rss.xml`} />
    <meta name="theme-color" content="#faf4ef" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="GRC Engineering Club AI Blog home">
        <span class="brand-mark" aria-hidden="true">GRC</span>
        <span>Engineering Club · AI Blog</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={base}>Home</a>
        <a href={`${base}posts/`}>Field notes</a>
        <a href="https://github.com/GRCEngClub" rel="external">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <p class="footer-title">Built in public.</p>
        <p>Practical AI workflows for GRC work and perspectives on AI governance. Sharing what we learn.</p>
      </div>
      <div class="footer-links">
        <a href={`${base}posts/`}>All posts</a>
        <a href={`${base}rss.xml`}>RSS feed</a>
        <a href="https://github.com/GRCEngClub/ai-blog">Source</a>
      </div>
    </footer>
  </body>
</html>
